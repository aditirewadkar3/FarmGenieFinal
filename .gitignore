# ============================================================
# Root .gitignore — FarmGenie Full Stack Project
# ============================================================

# ========================
# Node.js / JavaScript
# ========================
node_modules/
/.pnp
.pnp.js

# Build outputs
/dist
/dist-ssr
/build
/.next
/out

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ========================
# Environment Variables
# ========================
.env
.env.*
!.env.example
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

# ============================================================
# Python, Virtual Environments & Package Caches
# ============================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments (all packages & binaries)
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.Python

# Python distribution, build packaging & wheels
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
*.egg
*.whl
pip-wheel-metadata/
share/python-wheels/
__pypackages__/

# Pip installer logs
pip-log.txt
pip-delete-this-directory.txt
.installed.cfg
MANIFEST

# Unit test & type check caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# ============================================================
# Jupyter Notebooks Cache
# ============================================================
.ipynb_checkpoints/
*-checkpoint.ipynb

# ============================================================
# Large Machine Learning Models & Weights
# Downloadable via python ml_projet_models/download_models.py
# ============================================================
*.pth
*.pt
*.safetensors
*.keras
*.h5
*.bin
*.onnx
*.tflite
*.pkl
*.pb
*.tar.gz

# Pretrained model binary weight files (keep class_names.json & configs)
ml_projet_models/pretrained_models/beans/*.safetensors
ml_projet_models/pretrained_models/cotton/*.pth
ml_projet_models/pretrained_models/potato/*.keras
ml_projet_models/pretrained_models/rice/*.safetensors
ml_projet_models/pretrained_models/tomato/*.safetensors

# YOLO / Ultralytics / Wandb training outputs
runs/
wandb/
lightning_logs/

# ============================================================
# Application Data & Uploads
# ============================================================
backend/uploads/
uploads/
tmp/
temp/
*.tmp
*.bak
*.swp

# Database
*.sqlite
*.sqlite3

# Logs
logs/
*.log

# ============================================================
# IDE & Operating System Files
# ============================================================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
